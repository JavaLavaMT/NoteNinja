#!/bin/bash
APP_PATH="$HOME/Applications/NoteNinja.app"

echo ""
echo "Stopping NoteNinja..."
echo ""

# Kill the running menu bar process
pkill -f "menubar.py" 2>/dev/null && echo "Menu bar stopped." || echo "Menu bar was not running."

# Remove from Login Items
osascript <<'SCRIPT'
tell application "System Events"
    if login item "NoteNinja" exists then
        delete login item "NoteNinja"
    end if
end tell
SCRIPT

# Delete the app bundle
if [ -d "$APP_PATH" ]; then
    rm -rf "$APP_PATH"
    echo "Deleted: $APP_PATH"
fi

echo ""
echo "Done. Run 'nj' to start NoteNinja again."
echo ""
